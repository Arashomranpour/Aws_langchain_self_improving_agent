# Optional: the visual web UI (FastAPI). Not used by AgentCore — run this to
# "see the app" locally or host it anywhere that serves a container on a port.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app/src PIP_NO_CACHE_DIR=1
WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/
COPY web/ ./web/

EXPOSE 8080
CMD ["uvicorn", "selfforge.api:app", "--host", "0.0.0.0", "--port", "8080"]

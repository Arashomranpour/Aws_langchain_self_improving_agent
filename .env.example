# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Groq (https://console.groq.com/keys) — required only for provider=groq
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# AWS (for Bedrock AgentCore deploy) — usually taken from your AWS CLI profile
AWS_REGION=eu-west-1
